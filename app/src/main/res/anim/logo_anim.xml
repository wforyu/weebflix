<?xml version="1.0" encoding="utf-8"?>
<!-- Netflix Tudum-style: logo zooms in from small to big, then fades out -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/accelerate_decelerate_interpolator">

    <!-- Phase 1: Zoom in (0% - 60%) -->
    <scale
        android:fromXScale="0.3"
        android:fromYScale="0.3"
        android:toXScale="1.0"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="1000"
        android:startOffset="200" />

    <!-- Phase 2: Hold briefly, then fade out -->
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.0"
        android:duration="500"
        android:startOffset="1400" />

    <!-- Phase 3: Scale up slightly as it fades (like Netflix Tudum) -->
    <scale
        android:fromXScale="1.0"
        android:fromYScale="1.0"
        android:toXScale="1.3"
        android:toYScale="1.3"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="500"
        android:startOffset="1400" />

</set>
