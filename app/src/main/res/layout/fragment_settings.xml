<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/netflix_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/netflix_text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Provider"
            android:textColor="@color/netflix_text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCurrentProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/netflix_red"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupProviders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="8dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/netflix_divider"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/provider_domain"
            android:textColor="@color/netflix_text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCurrentUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/netflix_red"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/change_domain_hint"
            android:textColor="@color/netflix_text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search"
            android:textColor="@color/netflix_text_primary"
            android:textColorHint="@color/netflix_text_hint"
            android:hint="@string/enter_new_domain"
            android:inputType="textUri"
            android:padding="16dp"
            android:textSize="15sp"
            android:singleLine="true"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_chip_active"
            android:text="@string/save"
            android:textColor="@color/netflix_text_primary"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_chip"
            android:text="@string/reset_default"
            android:textColor="@color/netflix_text_secondary"
            android:textSize="15sp"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
