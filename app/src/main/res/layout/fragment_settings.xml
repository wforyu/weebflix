<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/netflix_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/netflix_text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Provider"
            android:textColor="@color/netflix_text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCurrentProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/netflix_red"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupProviders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="8dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/netflix_divider"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/provider_visibility_title"
            android:textColor="@color/netflix_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/provider_visibility_hint"
            android:textColor="@color/netflix_text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/provider_visibility_missav"
                android:textColor="@color/netflix_text_primary"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/swMissavEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/netflix_divider"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/provider_domain"
            android:textColor="@color/netflix_text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCurrentUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/netflix_red"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/change_domain_hint"
            android:textColor="@color/netflix_text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search"
            android:textColor="@color/netflix_text_primary"
            android:textColorHint="@color/netflix_text_hint"
            android:hint="@string/enter_new_domain"
            android:inputType="textUri"
            android:padding="16dp"
            android:textSize="15sp"
            android:singleLine="true"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_chip_active"
            android:text="@string/save"
            android:textColor="@color/netflix_text_primary"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_chip"
            android:text="@string/reset_default"
            android:textColor="@color/netflix_text_secondary"
            android:textSize="15sp"
            android:textAllCaps="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/netflix_divider"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:id="@+id/ytOAuthSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YouTube Login (OAuth)"
                android:textColor="@color/netflix_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvYtAuthStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/netflix_text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OAuth Client ID"
                android:textColor="@color/netflix_text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etYtClientId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search"
                android:textColor="@color/netflix_text_primary"
                android:textColorHint="@color/netflix_text_hint"
                android:hint="xxx.apps.googleusercontent.com"
                android:inputType="textNoSuggestions"
                android:padding="16dp"
                android:textSize="14sp"
                android:singleLine="true"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Client Secret (kosongkan untuk PKCE)"
                android:textColor="@color/netflix_text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etYtClientSecret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search"
                android:textColor="@color/netflix_text_primary"
                android:textColorHint="@color/netflix_text_hint"
                android:hint="Opsional"
                android:inputType="textNoSuggestions"
                android:padding="16dp"
                android:textSize="14sp"
                android:singleLine="true"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Redirect URI"
                android:textColor="@color/netflix_text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etYtRedirect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search"
                android:textColor="@color/netflix_text_primary"
                android:textColorHint="@color/netflix_text_hint"
                android:hint="http://localhost:8080/callback"
                android:inputType="textUri"
                android:padding="16dp"
                android:textSize="14sp"
                android:singleLine="true"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnYtAuthSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_chip_active"
                android:text="Simpan OAuth"
                android:textColor="@color/netflix_text_primary"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnYtLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_chip"
                android:text="@string/yt_logout"
                android:textColor="@color/netflix_red"
                android:textSize="15sp"
                android:textAllCaps="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yt_default_resolution_title"
                android:textColor="@color/netflix_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/yt_default_resolution_hint"
                android:textColor="@color/netflix_text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnYtResolution"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_chip"
                android:text="@string/yt_resolution_auto"
                android:textColor="@color/netflix_text_primary"
                android:textSize="15sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/about_app"
                android:textColor="@color/netflix_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pre_release_badge"
                android:textColor="@color/netflix_red"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:background="@drawable/bg_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/netflix_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/netflix_text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvAppCommit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/netflix_text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvAppBuildDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/netflix_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvAppDeveloper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/netflix_text_hint"
            android:textSize="12sp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_chip"
            android:text="@string/check_update"
            android:textColor="@color/netflix_text_secondary"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
