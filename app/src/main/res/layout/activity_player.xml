<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- ExoPlayer Container -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:resize_mode="fit" />
    </FrameLayout>

    <!-- Loading Spinner -->
    <ProgressBar
        android:id="@+id/loadingPlayer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/netflix_red"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Error Text -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:padding="24dp"
        android:textAlignment="center"
        android:visibility="gone"
        tools:text="Gagal memuat video" />

    <!-- Gesture Overlay (drawn before controls so controls get touches first) -->
    <FrameLayout
        android:id="@+id/gestureOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <!-- Brightness Indicator -->
    <LinearLayout
        android:id="@+id/brightnessIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginEnd="60dp"
        android:background="@drawable/bg_gesture_indicator"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_player_brightness"
            android:contentDescription="Brightness" />

        <ProgressBar
            android:id="@+id/brightnessProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressDrawable="@drawable/seekbar_progress"
            android:progress="50" />

        <TextView
            android:id="@+id/brightnessText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:text="50%" />
    </LinearLayout>

    <!-- Volume Indicator -->
    <LinearLayout
        android:id="@+id/volumeIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="60dp"
        android:background="@drawable/bg_gesture_indicator"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_player_volume"
            android:contentDescription="Volume" />

        <ProgressBar
            android:id="@+id/volumeProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressDrawable="@drawable/seekbar_progress"
            android:progress="50" />

        <TextView
            android:id="@+id/volumeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:text="50%" />
    </LinearLayout>

    <!-- Seek Indicator -->
    <LinearLayout
        android:id="@+id/seekIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_gesture_indicator"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/seekIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_player_skip_forward"
            android:contentDescription="Seek" />

        <TextView
            android:id="@+id/seekText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:text="+10s" />
    </LinearLayout>

    <!-- Netflix-style Top Controls Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_gradient_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_player_back"
            android:contentDescription="Back"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvAnimeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="One Piece" />

            <TextView
                android:id="@+id/tvEpisodeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/netflix_text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                tools:text="Episode 1 - Romance Dawn" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnPip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_player_pip"
            android:contentDescription="Picture in Picture"
            android:scaleType="centerInside" />

    </LinearLayout>

    <!-- Netflix-style Center Play/Pause Button -->
    <FrameLayout
        android:id="@+id/centerControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btnCenterPlayPause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:padding="12dp"
            android:src="@drawable/ic_player_pause"
            android:background="@drawable/bg_circle_semi_black"
            android:contentDescription="Play/Pause"
            android:scaleType="centerInside" />
    </FrameLayout>

    <!-- Skip Opening Button (Netflix-style bottom right) -->
    <TextView
        android:id="@+id/btnSkipOpening"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="150dp"
        android:background="@drawable/bg_skip_intro"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="@string/skip_opening"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Skip Outro Button (above skip opening position) -->
    <TextView
        android:id="@+id/btnSkipOutro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="200dp"
        android:background="@drawable/bg_skip_intro"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="@string/skip_outro"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Auto-play Next Episode Overlay -->
    <LinearLayout
        android:id="@+id/autoPlayOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="80dp"
        android:background="@drawable/bg_skip_intro"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvAutoPlayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/next_episode"
            android:textColor="@color/netflix_red"
            android:textSize="12sp"
            android:textAllCaps="false"
            tools:text="Episode 2 - The Morning" />

        <TextView
            android:id="@+id/tvAutoPlayCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            tools:text="5" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnCancelAutoPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="@string/cancel"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/btnPlayNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_active"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="@string/play_now"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Netflix-style Bottom Controls Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_gradient_bottom"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        android:paddingTop="32dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <!-- Current time / Seek bar / Duration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:text="00:00" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:max="100"
                android:progressDrawable="@drawable/seekbar_progress"
                android:thumbTint="@color/netflix_red"
                android:progressTint="@color/netflix_red"
                android:splitTrack="false" />

            <TextView
                android:id="@+id/tvTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:text="00:00" />
        </LinearLayout>

        <!-- Control buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_player_pause"
                android:contentDescription="Play/Pause"
                android:scaleType="centerInside" />

            <ImageView
                android:id="@+id/btnPrevEp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_player_skip_backward"
                android:contentDescription="Rewind 10s"
                android:scaleType="centerInside"
                android:layout_marginStart="8dp" />

            <ImageView
                android:id="@+id/btnNextEp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_player_skip_forward"
                android:contentDescription="Forward 10s"
                android:scaleType="centerInside"
                android:layout_marginStart="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Prev Episode -->
            <TextView
                android:id="@+id/btnPrevEpisode"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="← Ep"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:visibility="gone" />

            <!-- Server selector text -->
            <TextView
                android:id="@+id/tvServerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/netflix_text_secondary"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_chip"
                android:layout_marginStart="6dp"
                tools:text="Server 1" />

            <!-- Next Episode -->
            <TextView
                android:id="@+id/btnNextEpisode"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_chip_active"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Ep →"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:layout_marginStart="6dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnFullscreen"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_player_fullscreen"
                android:contentDescription="Fullscreen"
                android:scaleType="centerInside"
                android:layout_marginStart="8dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- WebView Player Overlay -->
    <FrameLayout
        android:id="@+id/webViewPlayerControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="10dp">

        <!-- Top bar (gradient) -->
        <LinearLayout
            android:id="@+id/wvTopBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_gradient_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/btnWebViewBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_player_back"
                android:contentDescription="Back"
                android:scaleType="centerInside" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tvWvAnimeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvWvEpisodeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/netflix_text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWvServerBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/netflix_text_secondary"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="4dp" />

            <ImageView
                android:id="@+id/btnWvPip"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_player_pip"
                android:contentDescription="Picture in Picture"
                android:scaleType="centerInside" />
        </LinearLayout>

        <!-- Center full-screen overlay (toggles controls + big play/pause) -->
        <FrameLayout
            android:id="@+id/wvCenterControls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btnWvCenterPlayPause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:padding="12dp"
                android:src="@drawable/ic_player_pause"
                android:background="@drawable/bg_circle_semi_black"
                android:contentDescription="Play/Pause"
                android:scaleType="centerInside" />
        </FrameLayout>

        <!-- Bottom bar (gradient) -->
        <LinearLayout
            android:id="@+id/wvBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_gradient_bottom"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp"
            android:paddingTop="32dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Seek bar row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvWvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:text="00:00" />

                <SeekBar
                    android:id="@+id/wvSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:max="100"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:thumbTint="@color/netflix_red"
                    android:progressTint="@color/netflix_red"
                    android:splitTrack="false" />

                <TextView
                    android:id="@+id/tvWvTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:text="00:00" />
            </LinearLayout>

            <!-- Controls row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <ImageView
                    android:id="@+id/btnWvPlayPause"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_player_pause"
                    android:contentDescription="Play/Pause"
                    android:scaleType="centerInside" />

                <ImageView
                    android:id="@+id/btnWvRewind"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_player_skip_backward"
                    android:contentDescription="Rewind 10s"
                    android:scaleType="centerInside"
                    android:layout_marginStart="8dp" />

                <ImageView
                    android:id="@+id/btnWvForward"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_player_skip_forward"
                    android:contentDescription="Forward 10s"
                    android:scaleType="centerInside"
                    android:layout_marginStart="4dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btnWvFullscreen"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_player_fullscreen"
                    android:contentDescription="Fullscreen"
                    android:scaleType="centerInside" />
            </LinearLayout>
        </LinearLayout>

        <!-- Loading spinner overlay -->
        <ProgressBar
            android:id="@+id/wvLoadingSpinner"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/netflix_red"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
