<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/netflix_card_bg"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/selector_focus_outline"
    android:stateListAnimator="@animator/focus_scale">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivGridPoster"
            android:layout_width="100dp"
            android:layout_height="138dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvGridTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvGridInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/netflix_text_hint"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvGridEpisode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/netflix_red"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvGridDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/netflix_text_hint"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
